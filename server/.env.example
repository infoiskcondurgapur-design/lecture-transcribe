# Local development (node --env-file-if-exists=.env)
PORT=4000
ADMIN_PASSWORD=changeme123
SESSION_SECRET=some-long-random-string-for-signing-cookies

# Optional: point local dev at a Turso database instead of the local file DB
# TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# Optional: enable Vercel Blob client uploads (needed on Vercel; local dev uses disk)
# BLOB_READ_WRITE_TOKEN=<token from Vercel dashboard>